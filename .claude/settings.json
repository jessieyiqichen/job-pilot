{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/preferences.md\" \"$CLAUDE_PROJECT_DIR/.claude/me.md\" 2>/dev/null || true",
            "statusMessage": "加载用户偏好与画像…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null && [ -n \"$(git status --porcelain 2>/dev/null)\" ] && echo '{\"systemMessage\":\"⚠️ 有未提交改动 — 要 commit 吗？顺便看看 README 要不要更新。\"}' || true"
          }
        ]
      }
    ]
  }
}
