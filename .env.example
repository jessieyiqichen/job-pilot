# JobPilot 密钥模板 — 复制为 .env 并填写真实值。
#   cp .env.example .env
# .env 已 gitignore，绝不提交。

# Claude API（AI 打分/定制/搜索必需）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Gmail SMTP（用于 --email 发送每日 digest）
# 用「应用专用密码」，不是登录密码：https://myaccount.google.com/apppasswords
JOBPILOT_SMTP_USER=you@gmail.com
JOBPILOT_SMTP_PASSWORD=your-16-char-app-password
# 收件人，默认发给自己（留空即用 SMTP_USER）
JOBPILOT_SMTP_TO=you@gmail.com

# 可选调参
# JOBPILOT_NEW_JOB_LOOKBACK_DAYS=1
# JOBPILOT_FOLLOWUP_STALE_DAYS=7
